# Arrivo shared
APP_NAME=Arrivo
APP_ENV=development

# Frontend
NEXT_PUBLIC_APP_NAME=Arrivo
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET_KEY=change_me_in_development
