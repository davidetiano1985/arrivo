POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://arrivo:arrivo_dev_password@localhost:5432/arrivo

# Payments placeholders
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

