# Arrivo shared
APP_NAME=Arrivo
APP_ENV=development

# Frontend
NEXT_PUBLIC_APP_NAME=Arrivo
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET_KEY=change_me_in_development
JWT_ALGORITHM=HS256

# PostgreSQL
POSTGRES_DB=arrivo
POSTGRES_USER=arrivo
POSTGRES_PASSWORD=arrivo_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://arrivo:arrivo_dev_password@localhost:5432/arrivo

# Payments placeholders
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ─── Frontend Next.js (vedi frontend/.env.local.example per dettagli) ────────
# NextAuth.js
NEXTAUTH_SECRET=change_me_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=https://arrivoapp.it

# Google OAuth — https://console.cloud.google.com/
# Callback: https://arrivoapp.it/api/auth/callback/google
# IMPORTANTE: in produzione impostare in .env sul VPS, NON in .env.local
# NON lasciare vuoti (GOOGLE_CLIENT_ID="") — causa errore "client_id is required"
GOOGLE_CLIENT_ID=inserisci-il-tuo-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=inserisci-il-tuo-client-secret

# Email SMTP
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@arrivoapp.it
SMTP_PASS=password-casella-smtp
SMTP_FROM=Arrivo <noreply@arrivoapp.it>

