// Prisma schema — Arrivo
// Database: PostgreSQL
// Auth: NextAuth.js v4 con @auth/prisma-adapter
// ORM: Prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enum ────────────────────────────────────────────────────────────────────

enum UserRole {
  super_admin
  gestore_locale
  manager
  staff
  cliente
}

enum RestaurantStatus {
  pending
  approved
  rejected
}

// ─── NextAuth models (richiesti da @auth/prisma-adapter) ─────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Utenti ──────────────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  numericId            Int       @default(autoincrement()) @unique
  name                 String?
  firstName            String?
  lastName             String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  password             String?   // null per utenti Google OAuth
  phone                String?
  role                 UserRole  @default(cliente)
  suspended            Boolean   @default(false)
  loginAttempts        Int       @default(0)
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  restaurants       Restaurant[]        // ristoranti di cui è owner
  adminLogsAsTarget AdminLog[]  @relation("targetUser")
  adminLogsAsAdmin  AdminLog[]  @relation("adminUser")
  loginEvents       LoginEvent[]
}

// ─── Audit log admin (immutabile) ────────────────────────────────────────────

model AdminLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  adminId     String?
  adminEmail  String
  targetId    String?
  targetEmail String
  action      String
  details     String?  @db.Text

  admin  User? @relation("adminUser",  fields: [adminId],  references: [id], onDelete: SetNull)
  target User? @relation("targetUser", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([targetId])
}

// ─── Login events (storico accessi) ─────────────────────────────────────────

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  success   Boolean
  ipAddress String?
  provider  String   @default("credentials")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// ─── Richieste registrazione locale ──────────────────────────────────────────

model LocaleRequest {
  id        String           @id @default(cuid())
  nome      String
  tipo      String?
  citta     String
  email     String
  telefono  String?
  status    RestaurantStatus @default(pending)
  note      String?          @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// ─── Ristoranti ──────────────────────────────────────────────────────────────

model Restaurant {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  tipo        String?
  description String?          @db.Text
  address     String?
  city        String?
  phone       String?
  email       String?
  status      RestaurantStatus @default(pending)
  ownerId     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
}
