# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL sulla VPS Aruba
# Formato: postgresql://UTENTE:PASSWORD@HOST:PORTA/NOME_DB
DATABASE_URL="postgresql://arrivo:PASSWORD@localhost:5432/arrivo"

# ─── NextAuth.js ─────────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET="CAMBIA_CON_STRINGA_CASUALE_SICURA"
NEXTAUTH_URL="https://arrivoapp.it"

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Da creare su: https://console.cloud.google.com/ → APIs & Services → Credentials
# Callback URL da registrare: https://arrivoapp.it/api/auth/callback/google
#
# PRODUZIONE: imposta questi valori in /root/arrivo/frontend/.env sul VPS.
#             Non usare .env.local — viene ignorato in produzione (NODE_ENV=production).
#             NON definire queste variabili come vuote in GitHub Actions Secrets:
#             il deploy script fa "source .env" prima di pm2 restart --update-env,
#             quindi le credenziali vengono sempre lette da .env su VPS.
#
# LOCALE: inserire i valori reali qui per testare Google OAuth in sviluppo.
GOOGLE_CLIENT_ID="inserisci-il-tuo-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="inserisci-il-tuo-client-secret"

# ─── Email — Aruba SMTP ──────────────────────────────────────────────────────
# Credenziali casella noreply@arrivoapp.it su Aruba
SMTP_HOST="smtps.aruba.it"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@arrivoapp.it"
SMTP_PASS="PASSWORD_CASELLA_ARUBA"
SMTP_FROM="Arrivo <noreply@arrivoapp.it>"
