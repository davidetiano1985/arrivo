# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL sulla VPS Aruba
# Formato: postgresql://UTENTE:PASSWORD@HOST:PORTA/NOME_DB
DATABASE_URL="postgresql://arrivo:PASSWORD@localhost:5432/arrivo"

# ─── NextAuth.js ─────────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET="CAMBIA_CON_STRINGA_CASUALE_SICURA"
NEXTAUTH_URL="https://arrivoapp.it"

# ─── Google OAuth (opzionale — per accesso con Google) ───────────────────────
# Da creare su: https://console.cloud.google.com/
# Callback URL da registrare: https://arrivoapp.it/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Email — Aruba SMTP ──────────────────────────────────────────────────────
# Credenziali casella noreply@arrivoapp.it su Aruba
SMTP_HOST="smtps.aruba.it"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@arrivoapp.it"
SMTP_PASS="PASSWORD_CASELLA_ARUBA"
SMTP_FROM="Arrivo <noreply@arrivoapp.it>"
